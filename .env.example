# Copy this file to ".env" and fill in your own values.
# The server reads .env automatically on startup (no extra package needed).

# --- Basics ---
PORT=3000
# Full URL of the site once live (used in Stripe redirect links):
SITE_URL=http://localhost:3000

# --- Admin login (/admin) ---
ADMIN_PASSWORD=change-to-a-strong-password
# Optional but recommended in production: keeps you logged in across server restarts.
ADMIN_SESSION_SECRET=

# --- Stripe (payment) ---
# Create an account at https://dashboard.stripe.com, get your keys under "Developers > API keys".
STRIPE_SECRET_KEY=
# Create a webhook endpoint pointing to {SITE_URL}/api/stripe/webhook
# for the "checkout.session.completed" event, and paste the signing secret here:
STRIPE_WEBHOOK_SECRET=

# --- Email notification on contact form submissions (optional) ---
# Without this, inquiries are still stored in data/contact-submissions.json
# and shown in the admin panel — this just adds an email notification too.
RESEND_API_KEY=

# --- Future: MCP / AI design tools (21st.dev, ui-ux-pro-max) ---
# These are used by Claude when you ask for further design/code help on the
# site — not by the site itself in production. Add them to Claude Code's own
# MCP setup (see README), not here.
